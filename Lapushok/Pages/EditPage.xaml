<Page x:Class="Lapushok.Pages.EditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Lapushok.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditPage">

    <Grid Background="White">
        <StackPanel HorizontalAlignment="Center" Margin="50" >

            <TextBlock>Артикул</TextBlock>
            <TextBox Text="{Binding Id}" Name="ArticleTb" IsReadOnly="True"></TextBox>


            <TextBlock>Название</TextBlock>
            <TextBox    Text="{Binding Name}" Name="NameTb"></TextBox>
            <TextBlock>Количество человек для производства</TextBlock>
            <TextBox    Text="{Binding CountPeople}" Name="AmountOfPeopleTb" PreviewTextInput="NumberOnly_PreviewTextInput"></TextBox>
            <TextBlock>Минимальная стоимость для агента</TextBlock>
            <TextBox    Text="{Binding MinPriceForAgent}" Name="MinPriceTb" PreviewTextInput="NumberOnly_PreviewTextInput"></TextBox>

            <TextBlock>Тип продукта</TextBlock>
            <ComboBox Name="ProductTypeCb" DisplayMemberPath="Name"  SelectedItem="{Binding ProductType_id}"></ComboBox>
            <TextBlock>Номер цеха</TextBlock>
            <ComboBox Name="WorkshopCb" DisplayMemberPath="Number"  ItemsSource="{Binding WorshopId}"></ComboBox>
            <TextBlock>Описание </TextBlock>
            <TextBox    Text="{Binding Description}" Name="DescriptionTb" PreviewTextInput="NumberOnly_PreviewTextInput" ></TextBox>
            <StackPanel HorizontalAlignment="Center" Width="280" Margin="5" Orientation="Horizontal">
                <Button   Width="80" Height="20" Name="SaveBtn" Margin="75 0 0  0" Click="SaveBtn_Click">Сохранить</Button>
                <Button Margin="5"  Width="50" Name="DeleteBtn" Click="DeleteBtn_Click">Удалить</Button>
                <Button Margin="5"  Width="50" Height="20" Name="CancelBtn" Click="CancelBtn_Click">Назад</Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
