<UserControl x:Class="Lapushok.Pages.ProductListUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="750" Height="120">
    <Border BorderThickness="1" BorderBrush="Gray" Padding="10" Margin="5" 
            Background="{Binding ProductBackground}">

        <Grid Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <!-- Изображение -->
                <ColumnDefinition Width="*"/>
                <!-- Описание продукта -->
                <ColumnDefinition Width="100"/>
                <!-- Цена -->
            </Grid.ColumnDefinitions>

            <!-- Изображение -->
            <Border BorderThickness="1" BorderBrush="Black" Background="White" 
                    Grid.Column="0" Padding="5" Margin="5">
                <Image Width="80" Height="80" Source="{Binding photobit}" 
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>

            <!-- Информация о продукте -->
            <StackPanel Grid.Column="1" Margin="10,0">
                <TextBlock FontSize="14" FontWeight="Bold"
                           Text="{Binding productType.Name}"/>
                <TextBlock FontSize="14" FontWeight="Bold"
                           Text="{Binding Name}"/>
                <TextBlock FontSize="12" Foreground="Gray"
                           Text="{Binding Id}"/>
                <TextBlock FontSize="12" TextWrapping="Wrap"
                           Text="{Binding allmaterials}"/>
            </StackPanel>

            <!-- Стоимость -->
            <TextBlock FontSize="14" FontWeight="Bold"
                       Text="{Binding MinPriceForAgent, StringFormat=C}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Grid.Column="2" Margin="10"/>
            <Button x:Name="EditBtn" Width="100" Height="30" Margin="0 50 0 0"  
                    Grid.Column="2" Click="EditBtn_Click">Редактировать</Button>
        </Grid>

    </Border>
</UserControl>
