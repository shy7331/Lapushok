<Page x:Class="Lapushok.Pages.AddPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="AddPage" Width="800">

    <Grid Background="White">
        <StackPanel HorizontalAlignment="Right" Margin="50">
            <TextBlock>Изображение</TextBlock>
            <Image Name="ProductImage" Width="150" Height="150" Stretch="Uniform"/>
            <Button Name="UploadImageBtn" Content="Выбрать изображение" Click="UploadImage_Click"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Center" Margin="50">

            <TextBlock>Артикул</TextBlock>
            <TextBox Text="{Binding Id}" Name="ArticleTb" IsReadOnly="True"/>

            <TextBlock>Название</TextBlock>
            <TextBox Text="{Binding Name}" Name="NameTb"/>

            <TextBlock>Количество человек для производства</TextBlock>
            <TextBox Text="{Binding CountPeople}" Name="AmountOfPeopleTb" PreviewTextInput="NumberOnly_PreviewTextInput"/>

            <TextBlock>Минимальная стоимость для агента</TextBlock>
            <TextBox Text="{Binding MinPriceForAgent}" Name="MinPriceTb" PreviewTextInput="NumberOnly_PreviewTextInput"/>

            <TextBlock>Тип продукта</TextBlock>
            <ComboBox Name="ProductTypeCb" DisplayMemberPath="Name" ItemsSource="{Binding ProductType_id}"/>

            <TextBlock>Номер цеха</TextBlock>
            <ComboBox Name="WorkshopCb" DisplayMemberPath="Number" ItemsSource="{Binding WorshopId}"/>

            <TextBlock>Описание</TextBlock>
            <TextBox Text="{Binding Description}" Name="DescriptionTb"/>

         
           

            <StackPanel HorizontalAlignment="Center" Width="280" Margin="5" Orientation="Horizontal">
                <Button Width="80" Height="20" Name="SaveBtn" Click="SaveBtn_Click">Сохранить</Button>
                <Button Margin="5" Width="50" Name="CancelBtn" Click="CancelBtn_Click">Назад</Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
