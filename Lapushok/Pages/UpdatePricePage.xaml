<Page x:Class="Lapushok.Pages.UpdatePricePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Изменение стоимости">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Выберите продукты для изменения стоимости"
                   FontSize="16" FontWeight="Bold" Margin="0 0 0 10"/>

        <!-- Список продуктов -->
        <ListBox x:Name="ProductListBox" Grid.Row="1"
                 SelectionMode="Extended" Height="300"
                 DisplayMemberPath="Name"/>

        <!-- Поле ввода и кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <TextBox x:Name="PriceTextBox" Width="100" PreviewTextInput="PriceTextBox_PreviewTextInput"/>
            <Button Content="Изменить стоимость" Click="UpdatePrice_Click" Margin="10 0"/>
            <Button Content="Назад" Click="Back_Click"/>
        </StackPanel>
    </Grid>
</Page>
